# Copy to .env (or paste into Portainer's stack environment editor).

# --- Required ---

# Postgres password for the stack's own database.
POSTGRES_PASSWORD=change-me

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# TMDB v4 read access token — https://www.themoviedb.org/settings/api
# Not strictly required to boot, but without it titles have no genres, cast, runtime
# or streaming availability, and recommendations get noticeably worse.
TMDB_API_TOKEN=

# --- Plex history (Tautulli) ---
# Tautulli is on the `home` network, so the container name resolves directly.
TAUTULLI_URL=http://tautulli:8181
TAUTULLI_API_KEY=

# --- Trakt ---
# Create an app at https://trakt.tv/oauth/applications
# Redirect URI: urn:ietf:wg:oauth:2.0:oob  (device flow — no callback needed)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_USER=me

# --- Optional ---
APP_PORT=8100
TMDB_REGION=US
CLAUDE_MODEL=claude-opus-5
TZ=UTC

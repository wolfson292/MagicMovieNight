@page "/"
@rendermode InteractiveServer
@using MagicMovieNight.Data
@using MagicMovieNight.Integrations.Ingest
@using MagicMovieNight.Web.Components.Shared
@using Microsoft.EntityFrameworkCore
@inject IRecommendationEngine Engine
@inject RatingService Ratings
@inject FeedbackService Feedback
@inject MovieNightDbContext Db
@inject ILogger<Home> Logger

<PageTitle>Tonight — MagicMovieNight</PageTitle>

<h1>What should we watch?</h1>
<p class="subtitle">
    Picked from what this house actually watches — Plex, Trakt, and whatever the
    streamers have coughed up.
</p>

<div class="panel">
    <div class="field">
        <label>Who's watching</label>
        <div class="row">
            <button class="chip @(_selectedPeople.Count == 0 ? "on" : "")"
                    @onclick="SelectHousehold">
                Everyone
            </button>
            @foreach (var person in _people)
            {
                <button class="chip @(_selectedPeople.Contains(person.Id) ? "on" : "")"
                        @onclick="() => TogglePerson(person.Id)">
                    @person.Name
                </button>
            }
        </div>
    </div>

    <div class="field">
        <label for="mood">In the mood for… (optional)</label>
        <input id="mood" type="text" @bind="_prompt" @bind:event="oninput"
               placeholder="something funny and under two hours" />
    </div>

    <div class="row" style="margin-bottom: 1rem;">
        <div style="flex: 1; min-width: 160px;">
            <label for="runtime">Max runtime (minutes)</label>
            <input id="runtime" type="number" min="20" max="400" step="10" @bind="_maxRuntime" />
        </div>
        <div style="flex: 1; min-width: 160px;">
            <label for="count">How many picks</label>
            <input id="count" type="number" min="1" max="10" @bind="_count" />
        </div>
    </div>

    <div class="row" style="gap: 1.5rem;">
        <label style="margin: 0; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
            <input type="checkbox" @bind="_libraryOnly" style="width: auto;" />
            Only things already on Plex
        </label>
        <label style="margin: 0; display: flex; align-items: center; gap: 0.5rem; cursor: pointer;"
               title="Lifts the exclusion on everything you've watched or marked as already seen">
            <input type="checkbox" @bind="_includeAlreadyWatched" style="width: auto;" />
            Suggest things we've already watched
        </label>
    </div>

    <div class="row" style="margin-top: 1.25rem;">
        <button class="primary" @onclick="GetPicks" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner"></span> <span>Thinking…</span>
            }
            else
            {
                <span>Pick something</span>
            }
        </button>
        @if (_run is not null && !_busy)
        {
            <span class="muted">
                @_run.CandidateCount candidates considered in @_run.Duration.TotalSeconds.ToString("N1")s
            </span>
        }
    </div>
</div>

@if (_error is not null)
{
    <div class="error">
        <strong>That didn't work.</strong>
        <div class="muted">@_error</div>
    </div>
}

@if (_run?.Recommendations.Count > 0)
{
    @if (_people.Count > 1)
    {
        <div class="row" style="margin-top: 1.5rem;">
            <span class="muted">Ratings apply to</span>
            <select @bind="_ratingPersonId" style="width: auto;">
                @foreach (var person in _people)
                {
                    <option value="@person.Id">@person.Name</option>
                }
            </select>
        </div>
    }

    <div class="picks">
        @foreach (var pick in _run.Recommendations.OrderBy(r => r.Rank))
        {
            var item = pick.MediaItem!;
            <div class="pick">
                @if (!string.IsNullOrWhiteSpace(item.PosterUrl))
                {
                    <img class="poster" src="@item.PosterUrl" alt="@item.Title" loading="lazy" />
                }
                else
                {
                    <div class="poster empty">@(item.Kind == MediaKind.Movie ? "🎬" : "📺")</div>
                }

                <div>
                    <div class="rank">@(pick.Rank == 1 ? "Top pick" : $"#{pick.Rank}")</div>
                    <h3>@item.DisplayTitle</h3>

                    <div class="meta">
                        <span class="tag">@(item.Kind == MediaKind.Movie ? "Film" : "Series")</span>
                        @if (item.RuntimeMinutes is > 0)
                        {
                            <span class="tag">@item.RuntimeMinutes min</span>
                        }
                        @foreach (var genre in item.Genres.Take(3))
                        {
                            <span class="tag">@genre</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(pick.WhereToWatch))
                        {
                            <span class="tag where">@pick.WhereToWatch</span>
                        }
                    </div>

                    <p class="pitch">@pick.Pitch</p>

                    @if (!string.IsNullOrWhiteSpace(pick.BasedOn))
                    {
                        <div class="based-on">@pick.BasedOn</div>
                    }

                    <div class="verdicts" style="margin-bottom: 0.6rem;">
                        <ThumbButtons Value="RatingFor(item.Id)"
                                      Disabled="@(_ratingPersonId == 0)"
                                      OnRate="v => RatePick(item.Id, v)" />
                        @if (_ratingPersonId == 0)
                        {
                            <span class="muted">Add a person to rate</span>
                        }
                    </div>

                    @* Two outcomes, both about the recommendation rather than the title.
                       Whether you liked it is a rating, and lives on the thumbs above. *@
                    <div class="verdicts">
                        <button class="chip @(pick.Verdict == Verdict.Watched ? "on" : "")"
                                title="Records this as watched tonight"
                                disabled="@(_ratingPersonId == 0)"
                                @onclick="() => SetVerdict(pick, Verdict.Watched)">
                            We watched it
                        </button>
                        <button class="chip @(pick.Verdict == Verdict.AlreadySeen ? "on" : "")"
                                title="Stops this being suggested again"
                                disabled="@(_ratingPersonId == 0)"
                                @onclick="() => SetVerdict(pick, Verdict.AlreadySeen)">
                            Already seen it
                        </button>
                        @if (pick.Verdict == Verdict.AlreadySeen)
                        {
                            <span class="muted">
                                Hidden from future picks unless you tick "Suggest things
                                we've already watched".
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (_run is not null && !_busy && _error is null)
{
    <div class="notice">
        Nothing to suggest yet. Check <a href="setup">Setup</a> — history needs to sync
        before there is anything to reason about.
    </div>
}

@code {
    private List<Person> _people = [];
    private readonly HashSet<int> _selectedPeople = [];

    private string? _prompt;
    private int? _maxRuntime;
    private int _count = 5;
    private bool _libraryOnly;
    private bool _includeAlreadyWatched;

    private bool _busy;
    private RecommendationRun? _run;
    private string? _error;

    /// <summary>Whose opinion a thumb click records. Picks are shown to the household,
    /// but a rating always belongs to one person.</summary>
    private int _ratingPersonId;

    private Dictionary<int, RatingValue> _ratingsByItem = [];

    protected override async Task OnInitializedAsync()
    {
        // Everyone, not just the household — picking for one person or a guest is a
        // normal thing to want, and the household is only the default.
        _people = await Db.People.OrderBy(p => p.Name).ToListAsync();

        _ratingPersonId = _people.FirstOrDefault(p => p.InHousehold)?.Id
            ?? _people.FirstOrDefault()?.Id
            ?? 0;
    }

    private void SelectHousehold() => _selectedPeople.Clear();

    private void TogglePerson(int id)
    {
        if (!_selectedPeople.Remove(id))
        {
            _selectedPeople.Add(id);
        }

        // Picking exactly one person to watch makes them the obvious owner of any
        // rating given on the results.
        if (_selectedPeople.Count == 1)
        {
            _ratingPersonId = _selectedPeople.Single();
        }
    }

    private RatingValue? RatingFor(int mediaItemId) =>
        _ratingsByItem.TryGetValue(mediaItemId, out var value) ? value : null;

    private async Task RatePick(int mediaItemId, RatingValue value)
    {
        if (_ratingPersonId == 0)
        {
            return;
        }

        var result = await Ratings.SetAsync(_ratingPersonId, mediaItemId, value);

        if (result is null)
        {
            _ratingsByItem.Remove(mediaItemId);
        }
        else
        {
            _ratingsByItem[mediaItemId] = result.Value;
        }
    }

    private async Task LoadRatingsForRunAsync()
    {
        if (_run is null || _ratingPersonId == 0)
        {
            _ratingsByItem = [];
            return;
        }

        var itemIds = _run.Recommendations.Select(r => r.MediaItemId).ToList();

        _ratingsByItem = await Db.Ratings
            .Where(r => r.PersonId == _ratingPersonId
                && itemIds.Contains(r.MediaItemId)
                && r.SeasonNumber == null)
            .ToDictionaryAsync(r => r.MediaItemId, r => r.Value);
    }

    private async Task GetPicks()
    {
        _busy = true;
        _error = null;
        _run = null;

        try
        {
            var run = await Engine.RecommendAsync(new RecommendationRequest
            {
                PersonIds = _selectedPeople.ToList(),
                Prompt = _prompt,
                Count = Math.Clamp(_count, 1, 10),
                MaxRuntimeMinutes = _maxRuntime,
                LibraryOnly = _libraryOnly,
                IncludeAlreadyWatched = _includeAlreadyWatched,
            });

            // The engine persists the run without the navigation properties loaded;
            // re-read so the cards have posters and genres to render.
            _run = await Db.RecommendationRuns
                .Include(r => r.Recommendations)
                .ThenInclude(rec => rec.MediaItem)
                .FirstOrDefaultAsync(r => r.Id == run.Id);

            _error = run.Error;

            await LoadRatingsForRunAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Recommendation request failed.");
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Clicking the active verdict clears it, which is simpler than a separate undo.
    /// "We watched it" also writes a real watch event, so the history reflects tonight
    /// even when it was watched somewhere nothing else can see.
    /// </summary>
    private async Task SetVerdict(Recommendation pick, Verdict verdict)
    {
        if (_ratingPersonId == 0)
        {
            return;
        }

        pick.Verdict = await Feedback.ApplyAsync(pick.Id, verdict, _ratingPersonId);
    }
}

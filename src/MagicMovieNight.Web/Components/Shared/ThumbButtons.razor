@* Three-state thumb control, plus an optional "Didn't watch" for history rows. Clicking
   the active value clears it, so there is no separate "remove rating" affordance to
   explain. *@

<div class="thumbs">
    <button class="chip thumb @(Value == RatingValue.Down ? "on down" : "")"
            title="Not for me"
            disabled="@Disabled"
            @onclick="() => Pick(RatingValue.Down)">
        👎
    </button>
    <button class="chip thumb @(Value == RatingValue.Up ? "on" : "")"
            title="Liked it"
            disabled="@Disabled"
            @onclick="() => Pick(RatingValue.Up)">
        👍
    </button>
    <button class="chip thumb @(Value == RatingValue.Loved ? "on" : "")"
            title="Loved it"
            disabled="@Disabled"
            @onclick="() => Pick(RatingValue.Loved)">
        ❤️
    </button>
    @if (AllowNotWatched)
    {
        <button class="chip thumb not-watched @(Value == RatingValue.NotWatched ? "on" : "")"
                title="Someone else watched this on a shared profile — leave it out of my taste"
                disabled="@Disabled"
                @onclick="() => Pick(RatingValue.NotWatched)">
            Didn't watch
        </button>
    }
</div>

@code {
    [Parameter]
    public RatingValue? Value { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Offer "Didn't watch". Only meaningful on something in the viewer's history —
    /// not on a suggestion they have not seen yet.
    /// </summary>
    [Parameter]
    public bool AllowNotWatched { get; set; }

    [Parameter]
    public EventCallback<RatingValue> OnRate { get; set; }

    private Task Pick(RatingValue value) => OnRate.InvokeAsync(value);
}
